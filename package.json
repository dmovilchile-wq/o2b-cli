{
  "name": "o2b",
  "version": "0.1.0",
  "private": true,
  "description": "O2B — AI Coding Environment Manager: inventory, doctor, conflict detection, and a security scanner for Claude Code and Codex.",
  "license": "MIT",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "doctor": "node packages/cli/bin/o2b.js doctor",
    "scan": "node packages/cli/bin/o2b.js scan ."
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^2.1.9",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "engines": {
    "node": ">=18"
  }
}
